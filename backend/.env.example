# Backend (FastAPI) settings. `make setup` copies this file to .env; never commit .env.
# Names and values: docs/glossary.md section 7 and docs/17-deployment.md section 4.
# Every value here is a safe local placeholder. Production refuses the placeholders.

# development | test | production. production turns on the strict start-up checks.
APP_ENV=development

# Local SQLite file (backend/dev.db). Tests use sqlite:// (in memory).
# Production: the Turso URL, with no token in it.
DATABASE_URL=sqlite:///./dev.db

# Turso auth token, production only. Passed to the driver, never logged. Empty locally.
DATABASE_AUTH_TOKEN=

# Signs session tokens. Production needs >= 32 random bytes, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-change-me

# Session length in minutes (8 hours).
JWT_TTL_MINUTES=480

# false for http://localhost; must be true in production.
COOKIE_SECURE=false

# Comma-separated browser origins allowed to call the API. Development only;
# empty in production, where the web app calls the API through its same-origin rewrite.
CORS_ORIGINS=http://localhost:3000

# OpenAI-compatible LLM for "Ask about pay". Ask is disabled while LLM_API_KEY is empty.
# Empty LLM_BASE_URL / LLM_MODEL mean the Gemini defaults (gemini-flash-latest).
# Groq: LLM_BASE_URL=https://api.groq.com/openai/v1 and a Groq model id.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=
LLM_API_KEY=

# Ask limits: questions per user per hour, and tool steps per question.
ASK_RATE_LIMIT_PER_HOUR=20
ASK_MAX_STEPS=4

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG

# Passwords for the seeded demo users (used by `make seed` only, not by the API).
# Production refuses these defaults.
SEED_ADMIN_PASSWORD=change-me-admin
SEED_HR_PASSWORD=change-me-hr
SEED_VIEWER_PASSWORD=change-me-viewer
