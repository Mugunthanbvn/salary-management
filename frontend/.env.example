# `make setup` copies this file to frontend/.env (git-ignored). Change values there, never here.

# Base URL of the FastAPI app. Used by the /api rewrite in next.config.ts and by
# server-side fetches. It has no NEXT_PUBLIC_ prefix, so it is never exposed to the browser:
# the browser always calls the relative path /api/v1/...
# The rewrite is fixed when `next build` runs, so set it before building (also on Vercel).
API_ORIGIN=http://localhost:8000

# Show the three demo accounts (names, emails, roles; never passwords) on /login.
# "true" only on the demo deployment. Inlined by `next build`, so set it before building.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
