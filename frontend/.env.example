# `make setup` copies this file to frontend/.env (git-ignored). Change values there, never here.

# Local development only: URL of uvicorn. Used by the /api proxy in next.config.ts and by
# server-side fetches. No NEXT_PUBLIC_ prefix, so it is never exposed to the browser.
# Do NOT set it on Vercel: there vercel.json routes /api to the backend service and the
# BACKEND_URL service binding (injected by Vercel) is used for server-side fetches.
API_ORIGIN=http://localhost:8000

# Show the three demo accounts (names, emails, roles; never passwords) on /login.
# "true" only on the demo deployment. Inlined by `next build`, so set it before building.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
