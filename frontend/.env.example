# `make setup` copies this file to frontend/.env (git-ignored). Change values there, never here.

# Base URL of the FastAPI app. Used by the /api rewrite in next.config.ts and by
# server-side fetches. It has no NEXT_PUBLIC_ prefix, so it is never exposed to the browser:
# the browser always calls the relative path /api/v1/...
API_ORIGIN=http://localhost:8000
