{
  "components": {
    "schemas": {
      "Country": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "default_currency": {
            "title": "Default Currency",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "default_currency",
          "is_active"
        ],
        "title": "Country",
        "type": "object"
      },
      "CurrencyOption": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "exponent": {
            "title": "Exponent",
            "type": "integer"
          }
        },
        "required": [
          "code",
          "exponent"
        ],
        "title": "CurrencyOption",
        "type": "object"
      },
      "Department": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "Department",
        "type": "object"
      },
      "EmploymentType": {
        "enum": [
          "FULL_TIME",
          "PART_TIME",
          "CONTRACTOR"
        ],
        "title": "EmploymentType",
        "type": "string"
      },
      "Features": {
        "description": "Optional features. `ask` is false when no LLM_API_KEY is configured.",
        "properties": {
          "ask": {
            "title": "Ask",
            "type": "boolean"
          }
        },
        "required": [
          "ask"
        ],
        "title": "Features",
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": true,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "code",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "db": {
            "const": "ok",
            "title": "Db",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "db",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JobFamily": {
        "description": "The pay family of a job role; the seed's band multipliers use it (docs/12 section 3).",
        "enum": [
          "ENGINEERING",
          "PRODUCT",
          "DESIGN",
          "SALES",
          "CUSTOMER_SUCCESS",
          "MARKETING",
          "OPERATIONS",
          "FINANCE",
          "PEOPLE",
          "LEGAL"
        ],
        "title": "JobFamily",
        "type": "string"
      },
      "JobRole": {
        "properties": {
          "department_id": {
            "title": "Department Id",
            "type": "integer"
          },
          "family": {
            "$ref": "#/components/schemas/JobFamily"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "department_id",
          "family"
        ],
        "title": "JobRole",
        "type": "object"
      },
      "Level": {
        "description": "Job level: L1 Associate, L2 Mid, L3 Senior, L4 Lead/Staff, L5 Principal, L6 Director.",
        "enum": [
          "L1",
          "L2",
          "L3",
          "L4",
          "L5",
          "L6"
        ],
        "title": "Level",
        "type": "string"
      },
      "LevelOption": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/Level"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "code",
          "label"
        ],
        "title": "LevelOption",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 1,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LoginResponse": {
        "description": "The signed-in user and the permissions of their current role.",
        "properties": {
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "title": "Permissions",
            "type": "array"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          }
        },
        "required": [
          "user",
          "permissions"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "features": {
            "$ref": "#/components/schemas/Features"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "title": "Permissions",
            "type": "array"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          }
        },
        "required": [
          "user",
          "permissions",
          "features"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "Permission": {
        "enum": [
          "EMPLOYEE_READ",
          "EMPLOYEE_WRITE",
          "SALARY_READ",
          "SALARY_WRITE",
          "INSIGHTS_READ",
          "EXPORT",
          "IMPORT",
          "ASK",
          "USER_ADMIN",
          "FX_ADMIN",
          "REFERENCE_ADMIN",
          "AUDIT_READ"
        ],
        "title": "Permission",
        "type": "string"
      },
      "Problem": {
        "additionalProperties": true,
        "description": "An RFC 9457 problem. Some problems add members, e.g. `current_version`.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "instance"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ReferenceData": {
        "description": "Every dropdown value, and what filters are validated against (docs/07 section 5).",
        "properties": {
          "countries": {
            "items": {
              "$ref": "#/components/schemas/Country"
            },
            "title": "Countries",
            "type": "array"
          },
          "currencies": {
            "items": {
              "$ref": "#/components/schemas/CurrencyOption"
            },
            "title": "Currencies",
            "type": "array"
          },
          "departments": {
            "items": {
              "$ref": "#/components/schemas/Department"
            },
            "title": "Departments",
            "type": "array"
          },
          "employment_types": {
            "items": {
              "$ref": "#/components/schemas/EmploymentType"
            },
            "title": "Employment Types",
            "type": "array"
          },
          "job_roles": {
            "items": {
              "$ref": "#/components/schemas/JobRole"
            },
            "title": "Job Roles",
            "type": "array"
          },
          "levels": {
            "items": {
              "$ref": "#/components/schemas/LevelOption"
            },
            "title": "Levels",
            "type": "array"
          },
          "salary_change_reasons": {
            "items": {
              "$ref": "#/components/schemas/SalaryReason"
            },
            "title": "Salary Change Reasons",
            "type": "array"
          }
        },
        "required": [
          "countries",
          "departments",
          "job_roles",
          "levels",
          "employment_types",
          "currencies",
          "salary_change_reasons"
        ],
        "title": "ReferenceData",
        "type": "object"
      },
      "Role": {
        "enum": [
          "ADMIN",
          "HR_MANAGER",
          "VIEWER"
        ],
        "title": "Role",
        "type": "string"
      },
      "SalaryReason": {
        "description": "Why a salary record was written.",
        "enum": [
          "HIRE",
          "PROMOTION",
          "MERIT",
          "MARKET_ADJUSTMENT",
          "CORRECTION"
        ],
        "title": "SalaryReason",
        "type": "string"
      },
      "SessionUser": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "email",
          "full_name",
          "role"
        ],
        "title": "SessionUser",
        "type": "object"
      },
      "ValidationProblem": {
        "additionalProperties": true,
        "description": "422 `validation`: one entry in `errors` per invalid field.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Errors",
            "type": "array"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "instance",
          "errors"
        ],
        "title": "ValidationProblem",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerToken": {
        "description": "The same JWT as `Authorization: Bearer` (server-side fetches).",
        "scheme": "bearer",
        "type": "http"
      },
      "SessionCookie": {
        "description": "The session JWT that POST /auth/login sets (browsers).",
        "in": "cookie",
        "name": "session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "ACME Salary Management API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not authenticated: no valid session, or the user is inactive"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "Validation failed"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many requests",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before trying again",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Client error"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server error"
          }
        },
        "summary": "Sign in (public)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not authenticated: no valid session, or the user is inactive"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "Validation failed"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Client error"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          },
          {
            "BearerToken": []
          }
        ],
        "summary": "Sign out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not authenticated: no valid session, or the user is inactive"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "Validation failed"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Client error"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          },
          {
            "BearerToken": []
          }
        ],
        "summary": "The signed-in user and features",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/countries": {
      "get": {
        "operationId": "countries_api_v1_countries_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Country"
                  },
                  "title": "Response Countries Api V1 Countries Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not authenticated: no valid session, or the user is inactive"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden: a required permission is missing"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "Validation failed"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Client error"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          },
          {
            "BearerToken": []
          }
        ],
        "summary": "Countries and their salary currency",
        "tags": [
          "reference"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "Validation failed"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Client error"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server error"
          }
        },
        "summary": "Health check (public)",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/reference": {
      "get": {
        "operationId": "reference_api_v1_reference_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferenceData"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not authenticated: no valid session, or the user is inactive"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden: a required permission is missing"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "Validation failed"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Client error"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          },
          {
            "BearerToken": []
          }
        ],
        "summary": "Reference data for forms and filters",
        "tags": [
          "reference"
        ]
      }
    }
  }
}
